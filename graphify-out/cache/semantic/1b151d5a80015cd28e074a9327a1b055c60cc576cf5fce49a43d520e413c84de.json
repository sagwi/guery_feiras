{"nodes": [{"id": "claude_guery_feiras", "label": "Guery Feiras (marketplace de feiras)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Produ\u00e7\u00e3o real com usu\u00e1rios reais; dois pap\u00e9is (comerciante e curador/admin via flag gf_admin)."}, {"id": "claude_breninjadb", "label": "BreninjaDB (Supabase compartilhado pyyyrzwdidcronhidkwb)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Projeto Supabase compartilhado com clientes reais em produ\u00e7\u00e3o em outros schemas (guery, nails_*, daniele, fyado); por isso todo SQL exige confirma\u00e7\u00e3o de schema alvo."}, {"id": "claude_schema_guery_feiras", "label": "Schema guery_feiras (exclusivo do app)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Isolamento por schema no banco compartilhado; nunca rodar SQL em public ou outro schema sem confirma\u00e7\u00e3o expl\u00edcita."}, {"id": "claude_status_inscricao", "label": "statusInscricao.ts \u2014 ponto \u00fanico de decis\u00e3o de status", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "L\u00f3gica de status de inscri\u00e7\u00e3o/pagamento centralizada num \u00fanico m\u00f3dulo para n\u00e3o ser duplicada em telas."}, {"id": "claude_carteira", "label": "carteira.ts \u2014 exemplo can\u00f4nico de l\u00f3gica pura + teste", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_fluxo_pagamento", "label": "Fluxo de pagamento fim a fim", "file_type": "conce